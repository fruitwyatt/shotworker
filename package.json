{
  "name": "shotworker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-apng.mjs && node scripts/smoke-worker-bundle.mjs",
    "gen:examples": "node scripts/gen-examples.mjs"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "onnxruntime-web": "^1.31.1",
    "pako": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
